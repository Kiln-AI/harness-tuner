/* The preview's stylesheet: ui_design.md sections 4, 6, 7 and 8 in TCSS.
   Colors are theme variables only. The themes are in preview_app.py. */

Screen {
    background: $background;
    color: $foreground;
}

/* Links (4.9): blue, underlined. The ↗ is in the text. */
Markup {
    link-color: $text-primary;
    link-background: transparent;
    link-style: underline;
    link-color-hover: $text-primary;
    link-background-hover: $boost;
    link-style-hover: underline bold;
}

/* 4.1 Title bar */
TitleBar {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $panel;
    & > .title-left { width: 1fr; }
    & > .title-right { width: auto; }
}

/* 4.2 Section header: no border, one blank line between sections */
SectionHeader {
    height: 1;
    & > .header-title { width: auto; }
    & > .header-context { width: 1fr; margin-left: 3; }
    & > .header-meta { width: auto; margin-left: 2; }
}
.section {
    height: auto;
    margin-top: 1;
}

/* 4.3 Card */
Card {
    height: auto;
    padding: 0 1;
    background: $surface;
    border: round $border-muted;
    border-title-color: $foreground;
    border-title-style: none;
    border-subtitle-color: $text-muted;
    border-subtitle-style: none;
    border-subtitle-align: right;
    &.-live { border: round $primary; }
}
CardGrid {
    height: auto;
    grid-size: 3;
    grid-rows: auto;
    grid-gutter: 1 1;
}

/* 4.5 Gauge, and every ProgressBar */
ProgressBar {
    width: 1fr;
    & > Bar { width: 1fr; }
    & > Bar > .bar--bar { color: $primary; background: $border-muted; }
    & > Bar > .bar--complete { color: $primary; background: $border-muted; }
}
.gauge {
    height: 1;
    & > .gauge-label { width: 6; color: $text-muted; }
    & > .gauge-value { width: 7; text-align: right; text-style: bold; }
    & > ProgressBar { margin: 0 2; }
    & > .gauge-limit { width: 7; text-align: right; color: $text-muted; }
}
.gauge-note {
    padding-left: 15;
    color: $text-muted;
}
RunScreen.-done ProgressBar > Bar > .bar--bar { color: $foreground; }

/* ---- Run screen layout (6) ---- */

#body {
    padding: 0 1;
    scrollbar-size-vertical: 1;
}
#top {
    height: auto;
    margin-top: 1;
    & > #goal { width: 1fr; min-width: 62; margin-top: 0; }
    & > #spend { width: 2fr; margin: 0 0 0 4; }
}
#bottom {
    margin-top: 1;
    height: auto;
    layout: vertical;
}
#log-lines {
    background: transparent;
    overflow-x: hidden;
    padding: 0;
    scrollbar-size-vertical: 1;
    &:focus { background-tint: transparent; }
}

/* At 150 columns and up: Experiments two-thirds, Log one third, full
   height. Below: stacked, the Log 12 rows high. */
Screen.-wide #bottom {
    layout: horizontal;
    height: 1fr;
    & > #experiments { width: 68%; height: auto; margin-top: 0; }
    & > #log { width: 1fr; height: 100%; margin: 0 0 0 2; }
    & #log-lines { height: 1fr; }
}
Screen.-narrow #bottom {
    & > #experiments { margin-top: 0; }
    & #log-lines { height: 12; }
}

/* Below 150 columns the Goal (62 columns of text) can't take a third of
   the width, so Goal and Time & spend stack too. */
Screen.-narrow #top {
    layout: vertical;
    & > #spend { width: 1fr; margin: 1 0 0 0; }
}

/* 7.5 Experiments */
.experiment-card {
    & > .line { height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
    & .judged { height: 1; }
    & .judged > .strip { width: 1fr; }
    & .judged > .count { width: auto; margin-left: 1; color: $text-muted; }
    & .labelled-bar { height: 1; }
    & .labelled-bar > .bar-label { width: auto; margin-left: 1; color: $text-muted; }
}
.step-lines {
    height: auto;
    margin-bottom: 1;
}
.subhead {
    color: $text-muted;
    margin-bottom: 1;
}
.wave-note {
    color: $text-muted;
    margin-top: 1;
}
#run-complete {
    width: 1fr;
    & > Markup { height: auto; }
}

/* ---- Start-up screen (8) ---- */

#transcript {
    padding: 1 2 0 2;
    scrollbar-size-vertical: 1;
    & > * { max-width: 128; }
}
#welcome {
    width: 68;
    margin-bottom: 1;
}
.startup-card {
    width: auto;
    max-width: 100%;
    margin-top: 1;
    & > Markup { width: auto; }
}
.-problem { border: round $error; }
.prompt {
    height: auto;
    margin-top: 1;
}
.prompt > .question { margin-bottom: 0; }
.prompt > .hint { margin-top: 0; }
.prompt > .error { height: 1; }
.prompt > .description { height: 1; margin-top: 1; }

/* Action menus and pickers: OptionList without its box; the highlighted
   row in reverse $primary, focused or not. */
OptionList.menu {
    width: auto;
    min-width: 30;
    height: auto;
    border: none;
    padding: 0;
    background: transparent;
    &:focus { border: none; background-tint: transparent; }
    & > .option-list--option-highlighted {
        color: $block-cursor-foreground;
        background: $primary;
        text-style: bold;
    }
    &:focus > .option-list--option-highlighted {
        color: $block-cursor-foreground;
        background: $primary;
        text-style: bold;
    }
    & > .option-list--option-disabled { color: $text-muted; }
}

/* Inputs: rounded like cards, blue with focus, red when invalid */
Input {
    width: 72;
    height: 3;
    padding: 0 1;
    background: $surface;
    border: round $border-muted;
    &:focus { border: round $primary; background-tint: transparent; }
    &.-invalid { border: round $error; }
    &.-invalid:focus { border: round $error; }
}

/* ---- Card gallery ---- */

#gallery {
    padding: 1 1 0 1;
}
.gallery-cell {
    height: auto;
    & > .caption { color: $text-muted; }
}

/* ---- 4.11 Stop dialog ---- */

StopDialog {
    align: center middle;
    background: $background 60%;
}
#dialog {
    width: 60;
    padding: 0 2;
    background: $panel;
    border: round $primary;
    & > Markup { margin: 1 0; }
}
#dialog-buttons {
    height: 1;
    align-horizontal: right;
    margin-bottom: 1;
    & > Button { margin-left: 2; padding: 0 2; }
}
#dialog-buttons Button {
    background: $border-muted;
    color: $foreground;
    &:focus { background: $primary; color: $block-cursor-foreground; text-style: bold; }
    &.-error { color: $text-error; }
    &.-error:focus { background: $error; color: $block-cursor-foreground; }
}
