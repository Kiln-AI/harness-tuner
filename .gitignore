/htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
/nosetests.xml
/coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
/cover/

# Translations
*.mo
*.pot

